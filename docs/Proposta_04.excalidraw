    {
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 7524,
      "version": 110,
      "versionNonce": 1911578023,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790597432011,
      "link": null,
      "locked": false,
      "roundness": null,
      "type": "text",
      "id": "t_1073",
      "x": 40,
      "y": 1825,
      "width": 878.8630908203113,
      "height": 44.24995422363274,
      "text": "Indústria: paga US$ 50 pelo material e recupera US$ 32,50 (65%) a US$ 39,50 (79%) em cupons → custo líquido de US$ 17,50 a US$ 10,50.\nEscrow em R$ via intermediador: os US$ 50 da compra do lote só são liberados após o recebimento confirmado (passo ③);\na blockchain só registra. Coletor também recebe R$ (Pix) na entrega, fora desta repartição. Valores em US$, ilustrativos.",
      "originalText": "Indústria: paga US$ 50 pelo material e recupera US$ 32,50 (65%) a US$ 39,50 (79%) em cupons → custo líquido de US$ 17,50 a US$ 10,50.\nEscrow em R$ via intermediador: os US$ 50 da compra do lote só são liberados após o recebimento confirmado (passo ③);\na blockchain só registra. Coletor também recebe R$ (Pix) na entrega, fora desta repartição. Valores em US$, ilustrativos.",
      "fontSize": 11.799987792968732,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b2A",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "angle": 0,
      "strokeColor": "#7048e8",
      "backgroundColor": "#f3f0ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 7531,
      "version": 150,
      "versionNonce": 486652407,
      "isDeleted": false,
      "boundElements": [],
